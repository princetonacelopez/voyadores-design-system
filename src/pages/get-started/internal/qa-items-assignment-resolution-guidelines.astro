---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';

const requiredColumns = [
  { name: 'Function', desc: 'The main area or module where the issue occurred.' },
  { name: 'Sub-Function', desc: 'The specific feature or screen within the main function.' },
  { name: 'Description of Feedback/Issues', desc: 'Detailed explanation of the bug or feedback.' },
  { name: 'Screenshot', desc: 'Visual proof or reference for the issue.' },
  { name: 'Remarks', desc: 'Additional notes or comments from QA or Developer.' },
  { name: 'Assigned To', desc: 'The specific developer responsible for the fix.' },
];

const colorStatuses = [
  { label: 'White / No Color', desc: 'Indicates an OPEN item', colorClass: 'status-white' },
  { label: 'Orange', desc: 'Indicates an item that is currently ON GOING fix by the developer', colorClass: 'status-orange' },
  { label: 'Green', desc: 'Indicates a PASSED item', colorClass: 'status-green' },
  { label: 'Red', desc: 'Denotes a FAILED item', colorClass: 'status-red' },
];
---

<BaseLayout title="QA Items Assignment and Resolution Guidelines">
  <PageHeader
    eyebrow="Get Started — Internal"
    title="QA Items Assignment and Resolution Guidelines"
    description="Guidelines to simplify and clarify the collection, identification, and assignment of QA items."
  />

  <section class="sec">
    <h2>Overview</h2>
    <p class="body-text">
      This guideline aims to provide guidance and to simplify with clarity the collection, identification, and
      assignment of QA items by the QA to the developer. QA items are issues raised after a Development Change.
      Development Changes can be a new application or additional features. QA items can be sourced from a QA, client,
      and/or any concerned party.
    </p>

    <div class="note-box">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="note-icon"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      <p class="note-text">
        Once QA items are received, a QA file must be created. The QA file should reside in a directory local to its
        project workspace and agreed upon by involved parties. A QA file should only contain items specific to the
        project.
      </p>
    </div>
  </section>

  <section class="sec">
    <h2>File Format and Tab Structure</h2>
    
    <div class="card-grid">
      <div class="format-card">
        <div class="card-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <div class="card-content">
          <h4>Filename</h4>
          <p class="body-text">
            <strong>Format:</strong> <code>QA-Project Name-Version</code><br />
            <strong>Example:</strong> <code>QA-eBilling-2.0</code>
          </p>
        </div>
      </div>

      <div class="format-card">
        <div class="card-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </div>
        <div class="card-content">
          <h4>Tabs</h4>
          <p class="body-text">
            <strong>Tabname:</strong> Current Project Version<br/>
            Use tabs to segregate different versions.
          </p>
        </div>
      </div>
    </div>

    <h3>Versioning</h3>
    <div class="version-list">
      <div class="version-item">
        <div class="version-badge">Major Version</div>
        <p class="body-text">This requires a new QA file spreadsheet entirely.</p>
      </div>
      <div class="version-item">
        <div class="version-badge version-badge--minor">Minor Version</div>
        <p class="body-text">Create a new tab from the major version of the QA file.</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <h2>Required Columns</h2>
    <p class="body-text">These are the required columns for the QA file to ensure all necessary information is captured.</p>
    
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Column Name</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {requiredColumns.map(col => (
            <tr>
              <td><strong>{col.name}</strong></td>
              <td>{col.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="sec">
    <h2>Updating & Assignment</h2>
    <p class="body-text">Assignment of items is agreed upon by the team. Once items are assigned, developers should follow the standard procedure and update the status of the item accordingly.</p>

    <h3>Color Coding Standard</h3>
    <p class="body-text">Below is the color scheme for updating the status of items in the QA file.</p>
    
    <div class="status-grid">
      {colorStatuses.map(status => (
        <div class="status-card">
          <div class:list={['status-indicator', status.colorClass]}></div>
          <div class="status-content">
            <h5 class="status-label">{status.label}</h5>
            <p class="status-desc">{status.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  .sec { margin-bottom: 72px; }

  .sec h2 {
    font-size: 20px; font-weight: 600; letter-spacing: -.4px; color: var(--black);
    margin-bottom: 24px; padding-bottom: 18px; border-bottom: 1px solid var(--g5);
  }

  .sec h3 {
    font-size: 18px; font-weight: 600; letter-spacing: -.3px; color: var(--black);
    margin-top: 36px; margin-bottom: 16px;
  }

  .sec h4 {
    font-size: 16px; font-weight: 600; letter-spacing: -.2px; color: var(--black);
    margin-bottom: 12px; margin-top: 0;
  }

  .body-text {
    font-size: 14px; font-weight: 500; color: var(--g1); line-height: 1.7;
    max-width: 720px; margin-bottom: 16px;
  }

  .body-text strong {
    font-weight: 700; color: var(--black);
  }
  
  .body-text code {
    background: var(--g6); padding: 2px 6px; border-radius: 4px;
    font-family: var(--mono); font-size: 13px; color: var(--brand);
  }

  /* Note Box */
  .note-box {
    display: flex; gap: 16px; padding: 20px;
    background: rgba(24,106,222,.05); border: 1px solid rgba(24,106,222,.15);
    border-radius: 8px; margin-top: 24px; max-width: 720px;
  }
  .note-icon { flex-shrink: 0; color: #186ade; margin-top: 2px; }
  .note-text { font-size: 14px; font-weight: 500; color: #114b9e; line-height: 1.6; margin: 0; }

  /* Card Grid */
  .card-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px; margin-top: 24px; margin-bottom: 32px; max-width: 720px;
  }
  .format-card {
    display: flex; gap: 16px; padding: 24px;
    background: var(--white); border: 1px solid var(--g5); border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  }
  .card-icon {
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 8px;
    background: var(--g6); color: var(--g2);
    display: flex; align-items: center; justify-content: center;
  }
  .card-content p { margin: 0; }

  /* Versioning */
  .version-list { display: flex; flex-direction: column; gap: 16px; max-width: 720px; }
  .version-item {
    display: flex; flex-direction: column; gap: 8px;
    padding: 16px 20px; border: 1px solid var(--g5); border-radius: 8px;
    background: var(--g6);
  }
  .version-badge {
    align-self: flex-start; font-size: 11px; font-weight: 700; letter-spacing: .05em;
    text-transform: uppercase; padding: 4px 10px; border-radius: 4px;
    background: var(--brand); color: var(--white);
  }
  .version-badge--minor { background: var(--g3); color: var(--white); }
  .version-item .body-text { margin: 0; }

  /* Table */
  .table-container {
    overflow-x: auto; margin-top: 24px; border: 1px solid var(--g5);
    border-radius: 8px; max-width: 720px;
  }
  .data-table {
    width: 100%; border-collapse: collapse; text-align: left;
    font-size: 14px;
  }
  .data-table th {
    background: var(--g6); padding: 14px 20px; font-weight: 600; color: var(--black);
    border-bottom: 1px solid var(--g5);
  }
  .data-table td {
    padding: 14px 20px; border-bottom: 1px solid var(--g5); color: var(--g1);
  }
  .data-table tr:last-child td { border-bottom: none; }
  
  /* Status Grid */
  .status-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px; margin-top: 24px; max-width: 720px;
  }
  .status-card {
    display: flex; align-items: flex-start; gap: 16px;
    padding: 20px; border: 1px solid var(--g5); border-radius: 8px;
    background: var(--white);
  }
  .status-indicator {
    flex-shrink: 0; width: 24px; height: 24px; border-radius: 6px;
    border: 2px solid rgba(0,0,0,0.1);
  }
  .status-white { background: #ffffff; border-color: var(--g4); }
  .status-orange { background: #f7921e; border-color: #d87b12; }
  .status-green { background: #28a745; border-color: #1e7e34; }
  .status-red { background: #dc3545; border-color: #bd2130; }
  
  .status-content { flex: 1; }
  .status-label {
    font-size: 15px; font-weight: 700; color: var(--black); margin: 0 0 6px 0;
  }
  .status-desc {
    font-size: 13px; font-weight: 500; color: var(--g1); line-height: 1.5; margin: 0;
  }
</style>